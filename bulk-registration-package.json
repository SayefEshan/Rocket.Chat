{
  "name": "rocketchat-bulk-user-import",
  "version": "2.0.0",
  "description": "Direct MongoDB bulk user import for Rocket.Chat",
  "main": "mongodb-user-import.js",
  "dependencies": {
    "mongodb": "^6.10.0",
    "bcrypt": "^5.1.1",
    "uuid": "^11.0.3"
  },
  "scripts": {
    "install-deps": "npm install",
    "import": "node mongodb-user-import.js",
    "test-connection": "node -e \"require('./mongodb-user-import.js').testConnection()\"",
    "import:dev": "node mongodb-user-import.js 10 --force",
    "import:json": "node mongodb-user-import.js users.json --force"
  },
  "keywords": [
    "rocketchat",
    "bulk-import",
    "mongodb",
    "user-management",
    "direct-database"
  ],
